NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/commerceops?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Production values belong in the host dashboard, not in this repository:
# NODE_ENV=production
# PORT=<provided-by-host>
# DATABASE_URL=<managed-postgres-url>
# JWT_SECRET=<32-plus-character-random-secret>
# CLIENT_ORIGIN=<public-app-origin>
# TRUST_PROXY_HOPS=1
