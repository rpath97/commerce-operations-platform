{
  "name": "commerce-operations-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Vendora – Full-Stack E-Commerce Operations Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "test": "npm run test -w server",
    "start": "npm run start -w server",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w server",
    "prisma:studio": "npm run prisma:studio -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.16.2"
  },
  "engines": {
    "node": ">=20"
  }
}
