# Package-level env files (copy the examples, then edit locally):
#   client/.env.example → client/.env
#   server/.env.example → server/.env
#
# Do not put real passwords, JWT secrets, or production DATABASE_URL values here.
#
# Production (Render dashboard, not committed files):
#   NODE_ENV=production
#   PORT=<provided-by-host>
#   DATABASE_URL=<managed-postgres-url>
#   JWT_SECRET=<32-plus-character-random-secret>
#   CLIENT_ORIGIN=<public-app-origin>
#   TRUST_PROXY_HOPS=1
#
# See docs/DEPLOYMENT.md.
